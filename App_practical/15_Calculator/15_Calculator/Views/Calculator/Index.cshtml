@model IEnumerable<_15_Calculator.Data.DataInputVariant>
@{
    ViewData["Title"] = "Калькулятор";
}

<h2>Калькулятор с Kafka</h2>

<form method="post" asp-action="Calculate">
    @Html.AntiForgeryToken()
    <input type="number" step="any" name="num1" required />
    <select name="operation" required>
        <option value="1">Сложение</option>
        <option value="2">Вычитание</option>
        <option value="3">Умножение</option>
        <option value="4">Деление</option>
    </select>
    <input type="number" step="any" name="num2" required />
    <input type="submit" value="Посчитать!" />
</form>

<hr />
<h3>История операций:</h3>
<table class="table">
    <thead>
        <tr>
            <th>Операнд 1</th>
            <th>Операция</th>
            <th>Операнд 2</th>
            <th>Результат</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Operand_1</td>
                    <td>@item.Type_operation</td>
                    <td>@item.Operand_2</td>
                    <td>@item.Result</td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="4">Нет данных для отображения</td>
            </tr>
        }
    </tbody>
</table>