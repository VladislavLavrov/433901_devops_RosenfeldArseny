@model CalculatorViewModel
@{
    ViewData["Title"] = "Калькулятор";
}

<section class="calculator">
    <h1>Мой самый лучший калькулятор</h1>
    <p class="subtitle">Выполнение основных арифметических операций</p>

    <form asp-controller="Calculator" asp-action="Index" method="post">
        @Html.AntiForgeryToken()
        <div class="field">
            <label asp-for="FirstNumber"></label>
            <input asp-for="FirstNumber" type="number" step="any" required />
        </div>
        <div class="field">
            <label asp-for="Operation"></label>
            <select asp-for="Operation">
                <option value="+">Сложение (+)</option>
                <option value="-">Вычитание (-)</option>
                <option value="*">Умножение (*)</option>
                <option value="/">Деление (/)</option>
            </select>
        </div>
        <div class="field">
            <label asp-for="SecondNumber"></label>
            <input asp-for="SecondNumber" type="number" step="any" required />
        </div>
        <button type="submit">Вычислить</button>
    </form>

    @if (!string.IsNullOrWhiteSpace(Model.Error))
    {
        <p class="message error">@Model.Error</p>
    }
    else if (Model.Result.HasValue)
    {
        <p class="message result">Результат: @Model.Result.Value</p>
    }
</section>
